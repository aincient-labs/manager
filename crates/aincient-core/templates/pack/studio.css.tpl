/* The rail sits in the console's DOM, so light/dark comes for free. Read
   SYSTEM tokens only (--ain-surface, --ain-text, …) — never --ain-ref-* and
   never the console's own classes; those are ours to move. */
.__MODULE__-studio { padding: 16px; color: var(--ain-text); }
.__MODULE__-studio__lede { color: var(--ain-text-muted); }
